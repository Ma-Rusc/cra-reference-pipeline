  "version": 1,
  "statements": [
    {
      "vulnerability": { "name": "CVE-2011-4116" },
      "products": [
        { "@id": "pkg:deb/debian/perl-base@5.40.1-6?arch=amd64&distro=debian-13.6&upstream=perl" }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "status_notes": "grype: severity=Negligible, fix.state=not-fixed.",
      "impact_statement": "perl-base ist eine Debian-Basispaket-Abhängigkeit des python:3.12-slim-Images (Bootstrap-/Postinst-Skripte zur Paketinstallation), keine von services/api-python installierte oder benötigte Abhängigkeit. Weder Dockerfile noch Anwendungscode (services/api-python/app) rufen perl oder ein perl-base-Binary/-Skript zur Laufzeit auf; verifiziert durch Fehlen jeglicher perl-, subprocess-, os.system- oder shell=True-Aufrufe im Anwendungscode. Der Prozess läuft ausschließlich als 'uv run uvicorn app.main:app'. Diese Begründung gilt unabhängig von der konkreten Schwachstelle in Perl selbst, da der Interpreter im Container nie gestartet wird."
    },
